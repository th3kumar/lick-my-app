{
  "$description": "Sundial design system v2 tokens. px values map 1:1 to dp/sp.",
  "color": {
    "chrome": {
      "canvas": { "$type": "color", "$value": "#FFFFFF" },
      "surface-sunken": { "$type": "color", "$value": "#F4F4F6" },
      "ink": { "$type": "color", "$value": "#0B0B0C" },
      "outline": { "$type": "color", "$value": "#1A1A1C" },
      "text-secondary": { "$type": "color", "$value": "#6B6B70" },
      "text-tertiary": { "$type": "color", "$value": "#C4C4C7" },
      "separator": { "$type": "color", "$value": "#E6E6EA" },
      "heat-empty": { "$type": "color", "$value": "#E9E9EC" },
      "pill-fill": { "$type": "color", "$value": "#F0F0F3" },
      "banner-close": { "$type": "color", "$value": "#DDDDE2" },
      "scrim": { "$type": "color", "$value": "rgba(11,11,12,0.18)" },
      "tip-ground": { "$type": "color", "$value": "#7FD8DE" }
    },
    "semantic": {
      "intent-more": { "$type": "color", "$value": "#34C759" },
      "intent-less": { "$type": "color", "$value": "#FF9F0A" },
      "destructive": { "$type": "color", "$value": "#FF3B30" },
      "confirm": { "$type": "color", "$value": "#34C759" },
      "stat": { "$type": "color", "$value": "#9AA3E0" },
      "stat-wash": { "$type": "color", "$value": "#C9CEF0" }
    },
    "accent-derivation": {
      "shadow": { "$value": "mix(accent, #FFFFFF, 0.48)" },
      "line": { "$value": "accent" },
      "text": { "$value": "accent" },
      "wash": { "$value": "accent @ 0.22 alpha" },
      "fill-max": { "$value": "accent" },
      "fill-n": { "$value": "accent @ (0.15 + 0.85 * v) alpha" },
      "empty": { "$value": "{color.chrome.heat-empty}" }
    },
    "accent-presets": ["#C2A24C", "#7AB648", "#4C8DC2", "#C24C7A", "#7A4CC2", "#C2704C"]
  },
  "elevation": {
    "outline-width": { "$type": "dimension", "$value": "1.5px" },
    "hard-offset": { "$type": "dimension", "$value": "3px" },
    "hard-offset-chip": { "$type": "dimension", "$value": "2px" },
    "hard-offset-section": { "$type": "dimension", "$value": "4px" },
    "hard-offset-hero": { "$type": "dimension", "$value": "5px" },
    "blur": { "$type": "dimension", "$value": "0px" },
    "css": { "$value": "3px 3px 0 0 <shadow>, 3px 3px 0 1.5px #1A1A1C" }
  },
  "radius": {
    "pill-sm": { "$type": "dimension", "$value": "8px" },
    "stepper": { "$type": "dimension", "$value": "10px" },
    "field": { "$type": "dimension", "$value": "12px" },
    "button": { "$type": "dimension", "$value": "14px" },
    "card": { "$type": "dimension", "$value": "16px" },
    "section": { "$type": "dimension", "$value": "20px" },
    "pill": { "$type": "dimension", "$value": "999px" },
    "cell": { "$type": "dimension", "$value": "4px" }
  },
  "space": {
    "base": { "$type": "dimension", "$value": "4px" },
    "gutter": { "$type": "dimension", "$value": "16px" },
    "card-pad-y": { "$type": "dimension", "$value": "14px" },
    "card-pad-x": { "$type": "dimension", "$value": "16px" },
    "row-pad-y": { "$type": "dimension", "$value": "13px" },
    "row-min-height": { "$type": "dimension", "$value": "48px" },
    "group-gap": { "$type": "dimension", "$value": "28px" },
    "token": { "$type": "dimension", "$value": "40px" },
    "token-sm": { "$type": "dimension", "$value": "32px" },
    "icon-button": { "$type": "dimension", "$value": "40px" },
    "arc-button": { "$type": "dimension", "$value": "72px" },
    "arc-ring-radius": { "$type": "dimension", "$value": "62px" },
    "heat-cell": { "$type": "dimension", "$value": "14px" },
    "heat-gap": { "$type": "dimension", "$value": "3px" }
  },
  "typography": {
    "family": { "$value": ["SF Pro Rounded", "Nunito"] },
    "display-stat": { "$value": { "size": "62px", "weight": 900, "letterSpacing": "-0.04em", "lineHeight": 1 } },
    "display-unit": { "$value": { "size": "34px", "weight": 900, "letterSpacing": "-0.02em", "lineHeight": 1 } },
    "title-screen": { "$value": { "size": "38px", "weight": 900, "letterSpacing": "-0.035em", "lineHeight": 1.1 } },
    "title-modal": { "$value": { "size": "30px", "weight": 900, "letterSpacing": "-0.03em", "lineHeight": 1.1 } },
    "title-section": { "$value": { "size": "24px", "weight": 900, "letterSpacing": "-0.02em", "lineHeight": 1.1 } },
    "item-title": { "$value": { "size": "19px", "weight": 800, "letterSpacing": "-0.01em", "lineHeight": 1.1 } },
    "metric": { "$value": { "size": "17px", "weight": 800 } },
    "row-label": { "$value": { "size": "16px", "weight": 700 } },
    "row-value": { "$value": { "size": "15px", "weight": 700 } },
    "button": { "$value": { "size": "15px", "weight": 800 } },
    "caption": { "$value": { "size": "13px", "weight": 600, "lineHeight": 1.5 } },
    "group-header": { "$value": { "size": "13px", "weight": 700 } },
    "arc-micro": { "$value": { "size": "11px", "weight": 800, "letterSpacing": "0.08em", "textTransform": "uppercase" } }
  },
  "motion": {
    "snap": { "compose": "tween(180, FastOutSlowInEasing)", "css": "180ms cubic-bezier(.2,0,0,1)" },
    "pop": { "compose": "spring(dampingRatio = 0.62f, stiffness = 420f)", "css": "420ms cubic-bezier(.34,1.56,.64,1)" },
    "commit": { "compose": "spring(dampingRatio = 0.42f, stiffness = 360f)", "css": "520ms cubic-bezier(.22,1.6,.36,1)" },
    "sheet": { "compose": "tween(380, EaseOutQuint)", "css": "380ms cubic-bezier(.16,1,.3,1)" },
    "settle": { "compose": "tween(220), stagger 28ms", "css": "700ms cubic-bezier(.16,1,.3,1)" },
    "press-down": { "compose": "tween(90)", "css": "90ms ease-out" },
    "press-up": { "compose": "spring(dampingRatio = 0.55f, stiffness = 400f)" },
    "recolor": { "compose": "tween(400)", "css": "400ms ease" }
  }
}
